<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Medical Checkup Appointment</title>
  <style>
    :root {
      --primary: #0f766e;
      --primary-dark: #115e59;
      --accent: #ecfeff;
      --text: #1f2937;
      --muted: #6b7280;
      --border: #dbe3ea;
      --bg: #f4f7fb;
      --card: #ffffff;
      --success: #166534;
      --shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: linear-gradient(135deg, #eef8f8, #f7fafc);
      color: var(--text);
    }

    .container {
      max-width: 980px;
      margin: 50px auto;
      padding: 20px;
    }

    .card {
      background: var(--card);
      border-radius: 20px;
      box-shadow: var(--shadow);
      overflow: hidden;
      border: 1px solid rgba(15, 118, 110, 0.08);
    }

    .header {
      background: linear-gradient(135deg, var(--primary), var(--primary-dark));
      color: white;
      padding: 24px 30px;
    }

    .header h1 {
      margin: 0 0 8px;
      font-size: clamp(1.7rem, 3vw, 2.5rem);
    }

    .header p {
      margin: 0;
      opacity: 0.9;
    }

    form {
      padding: 30px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(220px, 1fr));
      gap: 20px;
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .field.full {
      grid-column: 1 / -1;
    }

    label {
      font-weight: 600;
      font-size: 0.96rem;
    }

    input, select, textarea, button {
      font: inherit;
    }

    input, select, textarea {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: #fff;
      color: var(--text);
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 4px rgba(15, 118, 110, 0.12);
    }

    textarea {
      min-height: 120px;
      resize: vertical;
    }

    .checkbox-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 6px;
      color: var(--muted);
      font-size: 0.95rem;
    }

    .checkbox-row input {
      width: 18px;
      height: 18px;
      accent-color: var(--primary);
    }

    .actions {
      margin-top: 28px;
      display: flex;
      justify-content: flex-end;
      gap: 12px;
      flex-wrap: wrap;
    }

    button {
      border: none;
      border-radius: 12px;
      padding: 12px 22px;
      cursor: pointer;
      font-weight: 700;
      transition: transform 0.15s ease, opacity 0.15s ease;
    }

    button:hover {
      transform: translateY(-1px);
    }

    .primary-btn {
      background: var(--primary);
      color: white;
    }

    .secondary-btn {
      background: #eef2f7;
      color: var(--text);
    }

    .success-message {
      display: none;
      margin-top: 24px;
      background: #f0fdf4;
      color: var(--success);
      border: 1px solid #bbf7d0;
      border-radius: 12px;
      padding: 14px 16px;
      font-weight: 600;
    }

    @media (max-width: 700px) {
      .grid {
        grid-template-columns: 1fr;
      }
      form {
        padding: 20px;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="card">
      <div class="header">
        <h1>Medical Checkup Appointment</h1>
        <p>Please complete the form below to schedule your consultation.</p>
      </div>

      <form id="appointmentForm">
        <div class="grid">
          <div class="field">
            <label for="fullName">Full name</label>
            <input id="fullName" name="fullName" type="text" placeholder="John Smith" required />
          </div>

          <div class="field">
            <label for="dob">Date of birth</label>
            <input id="dob" name="dob" type="date" required />
          </div>

          <div class="field">
            <label for="phone">Phone number</label>
            <input id="phone" name="phone" type="tel" placeholder="+1 (555) 123-4567" required />
          </div>

          <div class="field">
            <label for="email">Email address</label>
            <input id="email" name="email" type="email" placeholder="john@example.com" required />
          </div>

          <div class="field">
            <label for="doctor">Preferred physician</label>
            <select id="doctor" name="doctor" required>
              <option value="">Select a doctor</option>
              <option>Dr. Amelia Foster</option>
              <option>Dr. James Lee</option>
              <option>Dr. Patricia Gomez</option>
              <option>Any available doctor</option>
            </select>
          </div>

          <div class="field">
            <label for="visitType">Checkup type</label>
            <select id="visitType" name="visitType" required>
              <option value="">Select type</option>
              <option>Annual Physical</option>
              <option>General Consultation</option>
              <option>Preventive Screening</option>
              <option>Follow-up Visit</option>
            </select>
          </div>

          <div class="field">
            <label for="date">Preferred date</label>
            <input id="date" name="date" type="date" required />
          </div>

          <div class="field">
            <label for="time">Preferred time</label>
            <select id="time" name="time" required>
              <option value="">Select time</option>
              <option>9:00 AM</option>
              <option>10:30 AM</option>
              <option>12:00 PM</option>
              <option>2:00 PM</option>
              <option>3:30 PM</option>
              <option>5:00 PM</option>
            </select>
          </div>

          <div class="field full">
            <label for="reason">Reason for appointment</label>
            <textarea id="reason" name="reason" placeholder="Briefly describe your health concern or the purpose of the visit..." required></textarea>
          </div>

          <div class="field full">
            <label for="insurance">Insurance provider</label>
            <input id="insurance" name="insurance" type="text" placeholder="ABC Health Insurance" />
          </div>

          <div class="field full">
            <div class="checkbox-row">
              <input type="checkbox" id="consent" name="consent" required />
              <label for="consent">I agree to the clinic’s privacy policy and consent to being contacted regarding this appointment.</label>
            </div>
          </div>
        </div>

        <div class="actions">
          <button type="reset" class="secondary-btn">Clear</button>
          <button type="submit" class="primary-btn">Book Appointment</button>
        </div>

        <div id="successMessage" class="success-message">
          Your appointment request has been submitted successfully. Our team will contact you shortly.
        </div>
      </form>
    </div>
  </div>

  <script>
    document.getElementById("appointmentForm").addEventListener("submit", function (event) {
      event.preventDefault();

      const successMessage = document.getElementById("successMessage");
      successMessage.style.display = "block";

      // Optional: reset form after 2 seconds
      setTimeout(() => {
        this.reset();
        successMessage.style.display = "none";
      }, 2500);
    });
  </script>
</body>
</html>
